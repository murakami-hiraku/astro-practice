---
interface Props {
  siteName?: string;
}

const { siteName = "Astro Practice" } = Astro.props;
---

<header>
  <div class="header-inner">
    <a href="/" class="logo">{siteName}</a>
    <nav>
      <ul>
        <li><a href="/">HOME</a></li>
        <li><a href="/about">ABOUT</a></li>
        <li><a href="/blog">BLOG</a></li>
        <li><a href="/contact">CONTACT</a></li>
      </ul>
    </nav>
  </div>
</header>

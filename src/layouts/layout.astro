---
import Header from "../components/Header.astro";
import "../scss/style.scss";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "My Portfolio",
  description = "Astroで制作したWebサイトです。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <Header siteName="My Portfolio" />

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; My Portfolio</p>
    </footer>
  </body>
</html>
